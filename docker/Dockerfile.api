# syntax=docker/dockerfile:1
FROM python:3.13-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
# Minimal package layout so pip can resolve the project without full tree
RUN mkdir -p apps src && touch apps/__init__.py src/__init__.py \
    && pip install --no-cache-dir --prefix=/install .

FROM python:3.13-slim AS runtime

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY --from=builder /install /usr/local
COPY apps ./apps
COPY src ./src
COPY alembic.ini pyproject.toml ./
COPY src/database/migrations ./src/database/migrations

# Drop playwright browsers and heavy optional bits if pulled in transitively
RUN pip uninstall -y playwright 2>/dev/null || true \
    && find /usr/local -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/local -type d -name 'tests' -exec rm -rf {} + 2>/dev/null || true

EXPOSE 8000
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
