# Core infrastructure
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5432/jobagent
REDIS_URL=redis://localhost:6379/0

# Telegram control plane
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 32-byte key, base64-encoded (generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())")
ENCRYPTION_KEY=

# Optional API key for HTTP control plane (empty = disabled in non-prod)
API_KEY=

# LLM
DEEPSEEK_API_KEY=
OMNIROUTE_ENDPOINT=https://api.deepseek.com/v1

# Browser domain allowlist (comma-separated hostnames)
ALLOWED_DOMAINS=boards-api.greenhouse.io,boards.greenhouse.io,api.lever.co,jobs.lever.co,www.linkedin.com,www.indeed.com,wellfound.com

# --- Matching policy --------------------------------------------------------
# Minimum deterministic score before the job goes to LLM qualification.
MATCH_THRESHOLD=40
MATCHING_WORKER_CONCURRENCY=5
LLM_WORKER_CONCURRENCY=3
EVIDENCE_REWRITE_PASSES=2
# Experience levels to favour. This is a ranking signal only; no role is
# rejected for its seniority wording. Ladder: intern, junior, mid, senior,
# staff, principal.
TARGET_SENIORITY=mid,senior
# Categories to keep: "all" or a comma list of software, frontend, backend,
# fullstack, mobile, data, ml_ai, devops, cloud, security, qa, blockchain,
# database, network, support, it_admin, architecture.
JOB_CATEGORIES=all
# Geographic preference (score boost, not a hard block).
PREFERRED_COUNTRIES=nigeria
ALLOW_WORLDWIDE_REMOTE=1
# remote_only (default) rejects on-site/office roles. "prefer" allows them at a
# lower score. "any" ignores location entirely.
REMOTE_MODE=remote_only
# Compensation floor used when the candidate profile has none.
MIN_SALARY=
SALARY_CURRENCY=USD

# Primary IT/tech discovery sources (enabled by default)
DISCOVERY_IOASSOCIATES_ENABLED=1
DISCOVERY_EXPERTWOKA_ENABLED=1
DISCOVERY_TURING_ENABLED=1
# micro1 gates its opportunity list behind an expert login; the adapter
# returns nothing when the public page is gated and never authenticates.
DISCOVERY_MICRO1_ENABLED=1

# Per-source fetch budgets
DISCOVERY_IOASSOCIATES_MAX_PAGES=4
DISCOVERY_EXPERTWOKA_MAX_PAGES=3
DISCOVERY_TURING_LOAD_MORE_CLICKS=3

# Per-poll cap on newly stored postings. Large first runs drain over
# successive polls so detail fetches stay bounded.
DISCOVERY_MAX_NEW_PER_TICK=25

# Legacy broad-board sources (opt-in only)
DISCOVERY_GREENHOUSE_ENABLED=0
DISCOVERY_LEVER_ENABLED=0
DISCOVERY_INDEED_ENABLED=0
DISCOVERY_LINKEDIN_ENABLED=0
DISCOVERY_WELLFOUND_ENABLED=0
DISCOVERY_COMPANY_CAREER_ENABLED=0
DISCOVERY_REMOTEOK_ENABLED=0
DISCOVERY_HIMALAYAS_ENABLED=0
DISCOVERY_YC_ENABLED=0
DISCOVERY_OTTA_ENABLED=0
DISCOVERY_ARC_ENABLED=0
DISCOVERY_CONTRA_ENABLED=0

# Optional board/company lists
GREENHOUSE_BOARD_TOKENS=airbnb,stripe
# Lever site names = jobs.lever.co/<site> slug, not legal company names
LEVER_COMPANIES=palantir,spotify

# Per-source rate limits (requests/minute); adapters also use rate_limit_per_minute class attrs
# DISCOVERY_POLL floor is 1 minute (apscheduler_config)

# --- Tailored documents -----------------------------------------------------
# Where generated CVs (PDF + DOCX) are written. Mount this in production so
# files survive redeploys; the Telegram worker reads from the same path.
DOCUMENT_OUTPUT_DIR=/app/data/generated_documents
# Set to 0 to omit the phone number from generated CVs.
CV_INCLUDE_PHONE=1
# Draft an application email when the posting publishes a recruitment address.
# Drafts are only ever shown in Telegram; the system never sends email.
APPLICATION_EMAIL_ENABLED=1
# Set 0 to stop generating drafts (the card then shows only the job URL).
NOTIFY_EMAIL_DRAFTS=1
# Set 0 to send the card without uploading the CV files.
NOTIFY_ATTACHMENTS=1

# --- Notification controls --------------------------------------------------
# Skip the card when the match score is below this (0 = send everything).
NOTIFY_MIN_SCORE=0
# Cap opportunity cards per day (0 = unlimited). Extra opportunities stay in
# the database and are not sent.
NOTIFY_MAX_PER_DAY=0

# --- Scheduling -------------------------------------------------------------
# One job per source; override per source, minimum 1 minute.
# DISCOVERY_IOASSOCIATES_POLL_INTERVAL_MINUTES=30
# DISCOVERY_EXPERTWOKA_POLL_INTERVAL_MINUTES=60
# DISCOVERY_TURING_POLL_INTERVAL_MINUTES=60
# DISCOVERY_MICRO1_POLL_INTERVAL_MINUTES=180
