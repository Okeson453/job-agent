# Core infrastructure
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5432/jobagent
REDIS_URL=redis://localhost:6379/0

# Telegram control plane
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 32-byte key, base64-encoded (generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())")
ENCRYPTION_KEY=

# Optional API key for HTTP control plane (empty = disabled in non-prod)
API_KEY=

# LLM
DEEPSEEK_API_KEY=
OMNIROUTE_ENDPOINT=https://api.deepseek.com/v1

# Browser domain allowlist (comma-separated hostnames)
ALLOWED_DOMAINS=boards-api.greenhouse.io,boards.greenhouse.io,api.lever.co,jobs.lever.co,www.linkedin.com,www.indeed.com,wellfound.com

# Application behaviour
APPLICATION_MODE_DEFAULT=APPROVAL
MATCH_THRESHOLD=40
BROWSER_WORKER_CONCURRENCY=2
MATCHING_WORKER_CONCURRENCY=5
LLM_WORKER_CONCURRENCY=3
EVIDENCE_REWRITE_PASSES=2

# Discovery source toggles
DISCOVERY_GREENHOUSE_ENABLED=1
DISCOVERY_LEVER_ENABLED=1
DISCOVERY_INDEED_ENABLED=0
DISCOVERY_LINKEDIN_ENABLED=0
DISCOVERY_WELLFOUND_ENABLED=0
DISCOVERY_COMPANY_CAREER_ENABLED=0

# Optional board/company lists
GREENHOUSE_BOARD_TOKENS=airbnb,stripe
# Lever site names = jobs.lever.co/<site> slug, not legal company names
LEVER_COMPANIES=palantir,spotify

# Per-source rate limits (requests/minute); adapters also use rate_limit_per_minute class attrs
# DISCOVERY_POLL floor is 1 minute (apscheduler_config)
